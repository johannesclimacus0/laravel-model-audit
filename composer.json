{
    "name": "johannesclimacus/model-audit",
    "description": "Laravel package for model change auditing and integrity verification.",
    "keywords": [
        "laravel",
        "audit",
        "eloquent",
        "history",
        "integrity"
    ],
    "homepage": "https://github.com/johannesclimacus0/laravel-model-audit",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Johannesclimacus\\ModelAudit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Johannesclimacus\\ModelAudit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Johannesclimacus\\ModelAudit\\ModelAuditServiceProvider"
            ]
        }
    },
    "support": {
        "issues": "https://github.com/johannesclimacus0/laravel-model-audit/issues",
        "source": "https://github.com/johannesclimacus0/laravel-model-audit"
    }
}
