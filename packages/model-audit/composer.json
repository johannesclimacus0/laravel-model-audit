{
    "name": "local/model-audit",
    "description": "Laravel package for recording model changes.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/http": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Local\\ModelAudit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Local\\ModelAudit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Local\\ModelAudit\\ModelAuditServiceProvider"
            ]
        }
    }
}
